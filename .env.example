PORT=3000
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"


# 2. confirme que .env real está ignorado (deve aparecer no .gitignore, já está)
git check-ignore -v .env

# 3. confirme que .env NUNCA foi commitado no histórico (importante!)
git log --all --full-history -- .env

# 4. commit da correção do .env.example
git add .env.example
git commit -m "fix: remove credencial real do .env.example, usa placeholder"
git push origin main